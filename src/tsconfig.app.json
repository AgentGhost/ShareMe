{
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "types": []
  },
  "extends": "../tsconfig.json",
  "exclude": [
    "environments/**",
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
